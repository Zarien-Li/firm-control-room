# Required project location
RESEARCH_PROJECT_ROOT=/absolute/path/to/research

# Local web server
FIRM_HOST=127.0.0.1
FIRM_PORT=8787

# Optional executables when they are not in PATH
# FIRM_CLAUDE_EXECUTABLE=/absolute/path/to/claude
# FIRM_CODEX_EXECUTABLE=/absolute/path/to/codex

# Independent Codex boundary audits
FIRM_CODEX_AUDIT_ENABLED=true
FIRM_REANCHOR_MODE=approval

# Optional remote GPU queue. Disabled by default.
FIRM_GPU_QUEUE_ENABLED=false
FIRM_GPU_SCHEDULER_AUTO_START=false
# FIRM_GPU_QUEUE_HOST=user@example-host
# FIRM_GPU_QUEUE_SSH_PORT=22
# FIRM_GPU_QUEUE_ROOT=/absolute/remote/path/to/gpu_queue
