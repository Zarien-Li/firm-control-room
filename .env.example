# Required project location
RESEARCH_PROJECT_ROOT=/absolute/path/to/research

# Local web server
FIRM_HOST=127.0.0.1
FIRM_PORT=8787

# Bounded local history. Job lifecycle rows remain canonical; these limits
# apply only to bulky raw control-room and GPU queue snapshots.
FIRM_SCAN_RETENTION=50
FIRM_GPU_SNAPSHOT_RETENTION=200

# The macOS service installer sets these to a stable state-directory socket
# and a separately launchd-managed broker. Leave auto-start enabled for a
# one-command development run.
# FIRM_BROKER_SOCKET=/absolute/path/to/firm-state/control-plane/broker.sock
FIRM_BROKER_AUTOSTART=true

# Optional executables when they are not in PATH
# FIRM_CLAUDE_EXECUTABLE=/absolute/path/to/claude
# FIRM_CODEX_EXECUTABLE=/absolute/path/to/codex

# Independent Codex boundary audits
FIRM_CODEX_AUDIT_ENABLED=true
FIRM_REANCHOR_MODE=auto

# Event-driven AI boundary resolution at genuine Claude input points.
# Failures are fail-closed: FIRM sends nothing without grounded output.
FIRM_OPERATIONAL_RESOLVER_ENABLED=true
FIRM_OPERATIONAL_RESOLVER_TIMEOUT_MS=600000
FIRM_OPERATIONAL_RESOLVER_ATTEMPTS=2
FIRM_OPERATIONAL_RESOLVER_MAX_CONCURRENCY=2
FIRM_OPERATIONAL_MESSAGE_COOLDOWN_MS=300000
FIRM_OPERATIONAL_MAX_MESSAGES_PER_HOUR=3

# Optional remote GPU queue. Disabled by default.
FIRM_GPU_QUEUE_ENABLED=false
FIRM_GPU_SCHEDULER_AUTO_START=false
# FIRM_GPU_QUEUE_HOST=user@example-host
# FIRM_GPU_QUEUE_SSH_PORT=22
# FIRM_GPU_QUEUE_ROOT=/absolute/remote/path/to/gpu_queue
# FIRM_GPU_QUEUE_DOCKER_CONTAINER=container-name-or-id
# Optional comma-separated allowlist and remote project-root boundary.
# FIRM_GPU_QUEUE_ALLOWED_PROJECTS=project-a,project-b
# FIRM_GPU_QUEUE_PROJECT_ROOT=/absolute/remote/path/to/projects
# FIRM_GPU_QUEUE_GPU_TYPE=NVIDIA A100 80GB
