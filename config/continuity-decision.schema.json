{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "message", "reason", "optionNumber"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["continue", "choose", "wait", "complete", "owner_required"]
    },
    "message": {
      "type": "string",
      "maxLength": 4000
    },
    "reason": {
      "type": "string",
      "maxLength": 2000
    },
    "optionNumber": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 99
    }
  }
}
